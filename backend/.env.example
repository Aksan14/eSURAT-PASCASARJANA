APP_ENV=development
PORT=8080
BASE_URL=http://localhost:8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=persuratan
DB_PASSWORD=persuratan
DB_NAME=persuratan
DB_SSLMODE=disable
# Jalankan migrasi GORM otomatis saat server start (matikan di production, pakai `migrate up`)
AUTO_MIGRATE=true

# Auth
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRY=24h

# CORS (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000

# Upload
MAX_UPLOAD_MB=5

# Storage: local | minio
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=persuratan
MINIO_USE_SSL=false

# Seed admin pertama
SEED_ADMIN_NIM=admin
SEED_ADMIN_NAME=Admin Pascasarjana
SEED_ADMIN_EMAIL=admin.pps@unismuh.ac.id
SEED_ADMIN_PASSWORD=admin123

# Template surat (kosongkan untuk memakai template embedded di templates/)
# Isi path direktori berisi letters/*.tmpl dan assets/*.png untuk override tanpa rebuild
LETTER_TEMPLATE_DIR=
# Placeholder {{ .Instansi.* }} — mengikuti kop & footer template resmi PPS
LETTER_YAYASAN=Majelis Pendidikan Tinggi Pimpinan Pusat Muhammadiyah
LETTER_UNIVERSITAS=Universitas Muhammadiyah Makassar
LETTER_UNIT=Program Pascasarjana
LETTER_ALAMAT=Jl. Sultan Alauddin No. 259
LETTER_TELEPON=(0411) 866 972 – 5047085
LETTER_FAX=(0411) 865 588
LETTER_WEBSITE=pasca.unismuh.ac.id
LETTER_KOTA=Makassar
LETTER_KODE_POS=90221
# Placeholder {{ .Penandatangan.* }} — dicetak "NBM : <LETTER_SIGNER_ID>"
LETTER_SIGNER_TITLE=Direktur,
LETTER_SIGNER_NAME=Prof. Dr. H. Irwan Akib, M.Pd.
LETTER_SIGNER_ID=613 949
